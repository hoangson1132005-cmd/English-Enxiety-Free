# PostgreSQL (dev: docker compose up -d db)
DATABASE_URL="postgresql://uth:uth_password@localhost:5432/uth_english?schema=public"

# Tạo bằng: npx auth secret
AUTH_SECRET="thay-bang-chuoi-ngau-nhien-dai"

# Lấy miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# URL công khai của website (dùng tạo link trong email đặt lại mật khẩu)
APP_URL="http://localhost:3000"

# SMTP gửi email (vd Gmail: smtp.gmail.com:587 + App Password)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="UTH English <no-reply@example.com>"
