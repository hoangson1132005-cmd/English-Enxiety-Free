generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  admin
}

enum FacultyGroup {
  language
  engineering
  other
}

enum CEFRLevel {
  A1
  A2
  B1
  B2
  C1
}

enum SkillType {
  listening
  reading
  writing
  speaking
  vocabulary
}

enum QuestionType {
  multiple_choice
  fill_blank
  true_false
  matching
  essay
  speaking
}

enum LessonStatus {
  locked
  available
  in_progress
  completed
}

model User {
  id                    String       @id @default(cuid())
  email                 String       @unique
  passwordHash          String
  role                  Role         @default(student)
  fullName              String
  studentId             String?
  avatarUrl             String?
  createdAt             DateTime     @default(now())
  lastActiveAt          DateTime     @default(now())

  onboardingCompleted   Boolean      @default(false)
  placementCompleted    Boolean      @default(false)

  employmentStatus      String       @default("student") // 'student' | 'employed'
  facultyGroup          FacultyGroup @default(engineering)
  major                 String?
  studyYear             Int          @default(1) // chỉ có ý nghĩa khi employmentStatus = 'student'
  researchConsent       Boolean      @default(false)

  goal                  String?
  interests             String       @default("[]") // JSON string[] các lĩnh vực/ngành nghề quan tâm
  dailyMinutes          Int          @default(20)
  selfAssessedLevel     CEFRLevel    @default(A1)
  currentLevel          CEFRLevel    @default(A1)

  streak                Int          @default(0)
  totalXp               Int          @default(0)
  notificationEnabled   Boolean      @default(true)
  darkMode              Boolean      @default(false)

  status                String       @default("active") // 'active' | 'disabled'

  testResults           TestResult[]
  lessonProgress        UserLessonProgress[]
  vocabProgress         UserVocabProgress[]
  chatMessages          ChatMessage[]
  dailyProgress         DailyProgress[]
  ownedVocabSets        VocabSet[]
  passwordResetTokens   PasswordResetToken[]
  roadmaps              UserRoadmap[]
  quizSessions          QuizSession[]
  lessonAttempts        LessonAttempt[]
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique // SHA-256 của token gửi qua email
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Test {
  id               String        @id @default(cuid())
  title            String
  description      String
  durationMinutes  Int
  isActive         Boolean       @default(false)
  createdAt        DateTime      @default(now())
  createdVia       String        @default("manual") // 'manual' | 'ai_import'
  sourceFileName   String?
  kind             String        @default("placement") // 'placement' | 'level_up'
  targetLevel      CEFRLevel?    // với level_up: dành cho học viên đang ở level này
  roadmapId        String?       // với level_up do AI tạo: gắn với lộ trình cụ thể
  sections         TestSection[]
  results          TestResult[]
}

model TestSection {
  id                 String     @id @default(cuid())
  testId             String
  test               Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  skill              SkillType
  title              String
  instructions       String
  timeLimitMinutes   Int?
  order              Int        @default(0)
  questions          Question[]
}

model Question {
  id              String        @id @default(cuid())
  skill           SkillType
  topic           String
  level           CEFRLevel
  type            QuestionType
  question        String
  options         String?       // JSON string[]
  answer          String        // JSON string | string[]
  explanation     String
  audioUrl        String?
  passage         String?
  testSectionId   String?
  testSection     TestSection?  @relation(fields: [testSectionId], references: [id], onDelete: SetNull)
  lessonId        String?
  lesson          Lesson?       @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  isActive        Boolean       @default(true) // false = tạm ẩn: không còn được bốc vào bài kiểm tra nhưng vẫn giữ trong ngân hàng
  inBank          Boolean       @default(false) // thuộc ngân hàng câu hỏi dùng chung (được bốc cho bài/chặng/bài thi)
  source          String        @default("manual") // 'manual' | 'import' | 'ai'
  usedCount       Int           @default(0)
  correctCount    Int           @default(0)
  createdAt       DateTime      @default(now())

  @@index([inBank, skill, level])
}

model Lesson {
  id               String   @id @default(cuid())
  order            Int      // thứ tự trong kho (giữ trật tự của giáo án khi AI xếp lộ trình)
  isPublished      Boolean  @default(false) // nháp cho tới khi admin xuất bản
  source           String   @default("") // nguồn / nhóm gốc của bài (tên chặng hoặc tài liệu đã import), chỉ để admin dễ quản lý
  title            String
  skill            SkillType
  durationMinutes  Int
  xpReward         Int
  description      String
  topic            String
  content          String   @default("") // nội dung giảng dạy (markdown) trước phần luyện tập
  level            CEFRLevel?
  quizMode         String   @default("auto") // 'auto' | 'own_first' (luôn có câu riêng của bài) | 'own_only' (chỉ dùng câu riêng của bài)
  quizSize         Int?     // số câu cuối bài của riêng bài này; để trống = theo cài đặt chung
  vocabItems       String   @default("[]") // JSON [{term, pronunciation, definition, definition_vi, example, example_vi}]
  questions        Question[]
  progress         UserLessonProgress[]
  roadmapItems     UserRoadmapItem[]
  attempts         LessonAttempt[]
}

model UserLessonProgress {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status       LessonStatus @default(locked)
  score        Int?
  completedAt  DateTime?

  @@unique([userId, lessonId])
}

model VocabSet {
  id           String      @id @default(cuid())
  title        String
  titleVi      String
  topic        String
  description  String
  icon         String
  ownerId      String?     // null = bộ từ hệ thống (công khai); có giá trị = bộ từ riêng của học viên
  owner        User?       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  cards        VocabCard[]
}

model VocabCard {
  id             String      @id @default(cuid())
  setId          String
  set            VocabSet    @relation(fields: [setId], references: [id], onDelete: Cascade)
  term           String
  pronunciation  String?
  definition     String
  definitionVi   String?
  example        String?
  exampleVi      String?
  topic          String?
  level          CEFRLevel?
  audioUrl       String?
  progress       UserVocabProgress[]
}

model UserVocabProgress {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId        String
  card          VocabCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  lastReviewed  DateTime?
  nextReview    DateTime?
  difficulty    String?    // 'easy' | 'hard' | 'unknown'
  mastered      Boolean    @default(false)

  @@unique([userId, cardId])
}

model TestResult {
  id                 String       @id @default(cuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  testId             String?
  test               Test?        @relation(fields: [testId], references: [id], onDelete: Cascade)
  sessionId          String?      // bài kiểm tra bốc từ ngân hàng (QuizSession)
  kind               String       @default("placement") // 'placement' | 'stage' | 'final' | 'level_up'
  completedAt        DateTime     @default(now())
  scores             String       // JSON SkillScores
  totalScore         Int
  cefrLevel          CEFRLevel
  toeicEquivalent    Int
  ieltsEquivalent    Float
  strengths          String       // JSON string[]
  weaknesses         String       // JSON string[]
  aiFeedback         String
  timeSpentSeconds   Int
  facultyGroup       FacultyGroup
  outcome            String?      // level_up test: 'level_up' | 'improve'
  roadmapId          String?
}

model ChatMessage {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String   // 'user' | 'assistant' | 'system'
  content    String
  createdAt  DateTime @default(now())
}

model DailyProgress {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime
  minutesStudied    Int      @default(0)
  xpEarned          Int      @default(0)
  lessonsCompleted  Int      @default(0)
  vocabReviewed     Int      @default(0)
  skills            String   @default("{}") // JSON Partial<SkillScores>

  @@unique([userId, date])
}

// Nội dung landing page do admin chỉnh sửa — 1 row duy nhất (singleton, id cố định "main")
model SiteContent {
  id                  String  @id @default("main")
  heroBadgeText       String
  heroTitleHighlight  String
  heroSubtitle        String
  whyChooseTitle      String
  whyChooseBullet1    String
  whyChooseBullet2    String
  whyChooseBullet3    String
  footerTagline       String
  logoImageBase64     String?
  logoMimeType        String?
  updatedAt           DateTime @updatedAt
}

// Lộ trình học riêng của từng học viên. Mỗi lần "học xong - thi - lên level/cải thiện" là một chu kỳ (cycle).
model UserRoadmap {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle          Int      @default(1)
  level          CEFRLevel // trình độ lúc bắt đầu chu kỳ
  kind           String   @default("initial") // 'initial' | 'level_up' | 'improve'
  status         String   @default("active") // 'active' | 'completed'
  generatedBy    String   @default("ai") // 'ai' | 'heuristic' | 'admin'
  rationale      String   @default("")
  focusSkills    String   @default("[]") // JSON SkillType[]
  phases         String   @default("[]") // JSON [{title, description}] — các chặng RIÊNG của học viên này
  createdAt      DateTime @default(now())
  completedAt    DateTime?
  items          UserRoadmapItem[]

  @@index([userId, status])
}

model UserRoadmapItem {
  id           String   @id @default(cuid())
  roadmapId    String
  roadmap      UserRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order        Int
  week         Int      @default(1)
  phase        Int      @default(1) // số thứ tự chặng (1-based) trong roadmap.phases
  reason       String   @default("")
  source       String   @default("ai") // 'ai' | 'admin' | 'suggested'
  status       String   @default("pending") // 'pending' | 'in_progress' | 'completed' | 'suggested' | 'dismissed'
  bestScore    Int?
  completedAt  DateTime?
  attempts     LessonAttempt[]

  @@unique([roadmapId, lessonId])
  @@index([roadmapId, order])
}

// Mỗi lần làm bài học: lưu đáp án + kết quả chi tiết để học viên xem lại, sửa sai và so sánh tiến bộ.
model LessonAttempt {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId          String
  lesson            Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  itemId            String?
  item              UserRoadmapItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  score             Int
  passed            Boolean
  answers           String   // JSON {questionId: answer}
  results           String   // JSON [{question_id, score, feedback, correct_answer}]
  reviewSummary     String   @default("")
  timeSpentSeconds  Int      @default(0)
  createdAt         DateTime @default(now())

  @@index([userId, lessonId])
}

// File âm thanh do admin upload cho câu hỏi nghe. Lưu trong DB để không phụ thuộc ổ đĩa của máy chủ khi deploy.
model AudioFile {
  id          String   @id @default(cuid())
  fileName    String
  mimeType    String
  sizeBytes   Int
  data        Bytes
  createdAt   DateTime @default(now())
}

// Một lượt kiểm tra với bộ câu hỏi đã được chọn sẵn (từ ngân hàng + AI bù thiếu), giữ cố định cho tới khi nộp bài.
model QuizSession {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         String    // 'lesson' | 'stage' | 'final'
  lessonId     String?
  roadmapId    String?
  phase        Int?
  questionIds  String    // JSON string[] theo thứ tự hiển thị
  status       String    @default("open") // 'open' | 'submitted'
  score        Int?      // điểm khi đã nộp
  results      String?   // JSON [{question_id, score}] khi đã nộp, để admin xem lại
  createdAt    DateTime  @default(now())
  submittedAt  DateTime?

  @@index([userId, kind, status])
}

// Câu hỏi học viên đã gặp, để các lần kiểm tra sau ưu tiên câu mới.
model QuestionSeen {
  userId      String
  questionId  String
  createdAt   DateTime @default(now())

  @@id([userId, questionId])
}

// Cài đặt chung cho mọi bài kiểm tra (1 dòng duy nhất, id = "main")
model QuizSettings {
  id                 String   @id @default("main")
  lessonSize         Int      @default(8)
  lessonSizeFreeText Int      @default(5)
  stageSize          Int      @default(18)
  finalSize          Int      @default(30)
  passScore          Int      @default(70)
  updatedAt          DateTime @updatedAt
}
